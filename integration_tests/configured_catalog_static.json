            },
            "targetUrl": {
              "type": [
                "string",
                "null"
              ],
              "description": "URL Orca Scan calls when the event fires."
            },
            "eventName": {
              "type": [
                "string",
                "null"
              ],
              "description": "One of the sheet's hook-events, e.g. rows:add, rows:update, rows:delete, sheet:clear, or * for all."
            },
            "sheetId": {
              "type": [
                "string",
                "null"
              ]
            },
            "enabled": {
              "type": [
                "boolean",
                "null"
              ]
