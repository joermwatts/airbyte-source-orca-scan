{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "_id": { "type": "string", "description": "Sheet id (24-character hex)." },
    "name": { "type": ["string", "null"], "description": "Sheet title as shown in Orca Scan." },
    "isOwner": { "type": ["boolean", "null"], "description": "True if the API key's user owns the sheet." },
    "canAdmin": { "type": ["boolean", "null"] },
    "canUpdate": { "type": ["boolean", "null"] },
    "canDelete": { "type": ["boolean", "null"] },
    "canExport": { "type": ["boolean", "null"] }
  }
}
